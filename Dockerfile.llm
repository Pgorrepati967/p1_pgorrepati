FROM ubuntu:24.04
RUN apt-get update && apt-get install -y wget ca-certificates \
    && wget -O ape https://cosmo.zip/pub/cosmos/bin/ape-x86_64.elf \
    && chmod +x ape \
    && wget -O google_gemma-3-4b-it-Q6_K.llamafile https://huggingface.co/Mozilla/gemma-3-4b-it-llamafile/resolve/main/google_gemma-3-4b-it-Q6_K.llamafile \
    && chmod +x google_gemma-3-4b-it-Q6_K.llamafile
CMD ["./ape", "./google_gemma-3-4b-it-Q6_K.llamafile"]
